<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Arguments -->
  <arg name="launch_driver" default="true" description="do launch driver"/>
  <arg name="vehicle_mirror_param_file" default=""/>
  <arg name="use_pointcloud_container" default="true"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="rslidar_config_file" default="$(find-pkg-share reva_sensor_kit_launch)/config/rslidar_config.yaml" description="Path to rslidar config file"/>

  <!-- RSLidar Driver -->
  <group>
    <push-ros-namespace namespace="lidar"/>
    
    <group>
      <push-ros-namespace namespace="top"/>
      
      <!-- RSLidar SDK Node -->
      <group if="$(var launch_driver)">
        <node pkg="rslidar_sdk" exec="rslidar_sdk_node" name="rslidar_sdk_node" output="screen" respawn="true" respawn_delay="1.0">
          <param name="config_path" value="$(var rslidar_config_file)"/>
          <!-- Remap rslidar point cloud topic to Autoware expected topic -->
          <remap from="/rslidar_points" to="pointcloud_raw"/>
        </node>
      </group>
    </group>
  </group>

  <!-- Relay pointcloud to sensing namespace for Autoware pipeline -->
  <group>
    <node pkg="topic_tools" exec="relay" name="lidar_pointcloud_relay" output="log">
      <remap from="input" to="/lidar/top/pointcloud_raw"/>
      <remap from="output" to="/sensing/lidar/top/pointcloud_before_sync"/>
      <param name="reliability" value="best_effort"/>
    </node>
  </group>
</launch>
